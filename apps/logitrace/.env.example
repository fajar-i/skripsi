# ==============================================================================
# LOGITRACE CONFIGURATION — copy to .env and fill in. NEVER commit .env.
# ==============================================================================

# LLM provider: 9router local OpenAI-compatible proxy (the only supported provider)
NINEROUTER_API_URL=http://localhost:20128/v1/chat/completions
NINEROUTER_API_KEY=sk-your-9router-api-key-here
NINEROUTER_MODEL=ag/gemini-3.8-flash-low

# Database
DATABASE_URL=sqlite+aiosqlite:///./logitrace.db
ENVIRONMENT=development

# Authentication
# Teacher dashboard password. If empty, one is generated into teacher_password.txt on first run.
LOGITRACE_TEACHER_PASSWORD=
# Signing key for login cookies. If empty, one is generated into .secret_key.
LOGITRACE_SECRET_KEY=
