# ==============================================================================
# LOGITRACE (RAG-KT) CONFIGURATION & SECURE API CREDENTIALS
# ==============================================================================

# LLM Provider: '9router', 'deepseek', 'groq', 'openai', or 'ollama' (default: auto-detected)
LOGITRACE_LLM_PROVIDER=9router

# 1. 9router Local OpenAI-Compatible Proxy (Default / Recommended Local Routing)
NINEROUTER_API_URL=http://localhost:20128/v1/chat/completions
NINEROUTER_API_KEY=sk-your-9router-api-key-here
NINEROUTER_MODEL=ag/gemini-3.8-flash

# 2. DeepSeek API Configuration (Direct Cloud: ~$0.14 / 1M tokens, latency < 0.8s)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 3. Groq Cloud API Configuration (Free tier: ~300 tokens/s, latency < 0.5s)
GROQ_API_KEY=your_groq_api_key_here

# 4. Model Name Selection (Overrides provider default if set)
# For 9router: ag/gemini-3.8-flash
# For DeepSeek: deepseek-chat
# For Groq: llama-3.1-8b-instant
# For Ollama Local: qwen2.5:3b
LOGITRACE_LLM_MODEL=ag/gemini-3.8-flash

# 5. Local Ollama Fallback URL (if running Ollama directly)
LOGITRACE_OLLAMA_URL=http://localhost:11434/api/generate

# 6. Database & Server Configuration
LOGITRACE_DB_URL=sqlite+aiosqlite:///./logitrace_dev.db
DATABASE_URL=sqlite+aiosqlite:///./logitrace_dev.db
ENVIRONMENT=production
